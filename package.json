{
  "name": "toolbahn",
  "productName": "Toolbahn",
  "version": "1.0.0-rc.3",
  "description": "Toolbahn CAD/CAM – Konstruktion und Fertigung, offline",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vbleich-lab/Toolbahn.git"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Toolbahn --platform=win32 --arch=x64 --out=dist --overwrite --icon=electron/icon.ico --app-version=1.0.0 --win32metadata.ProductName=Toolbahn --win32metadata.FileDescription=\"Toolbahn CAD/CAM\" --ignore=^/dist --ignore=^/node_modules --ignore=^/package-lock[.]json --ignore=^/start[.]bat --ignore=^/build-exe[.]bat --ignore=^/build-web[.]bat --ignore=^/tools --ignore=^/docs --ignore=/rust/openfab-kernel --ignore=^/[.]claude --ignore=^/[.]git",
    "build:web": "node tools/build-web.mjs",
    "build:kernel": "node tools/build-kernel.mjs",
    "test:kernel": "node tools/test-rust-kernel.mjs",
    "test:trim": "node tools/test-trim.mjs",
    "test:sketch": "node tools/test-sketchtools.mjs && node tools/test-sketchcorner.mjs && node tools/test-sketchoffset.mjs",
    "test:solver": "node tools/test-solver-arcs.mjs",
    "test:cam": "node tools/test-cam.mjs",
    "test:hh": "node tools/test-heidenhain.mjs",
    "test:iso": "node tools/test-iso.mjs",
    "test:lathe": "node tools/test-lathe.mjs",
    "test:drawing": "node tools/test-drawing.mjs",
    "test:i18n": "node tools/test-i18n.mjs",
    "test": "npm run test:trim && npm run test:sketch && npm run test:solver && npm run test:kernel && npm run test:cam && npm run test:hh && npm run test:iso && npm run test:lathe && npm run test:drawing && npm run test:i18n"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.4.11"
  }
}
